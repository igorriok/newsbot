TELEGRAM_BOT_TOKEN=your_bot_token_here
# OpenAI-compatible chat completions endpoint (aimage: create an ak_... key on its /api-keys page)
LLM_API_KEY=ak_your_aimage_api_key_here
LLM_BASE_URL=https://ai.solonari.com/api/v1
# LLM_MODEL_ID=gemma-4-e4b-it-qat
# Per-request timeout and delay between retries when the API answers 503 (model loading)
# LLM_TIMEOUT_MS=120000
# LLM_RETRY_DELAY_MS=5000
DATABASE_PATH=./data/newsbot.db
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=123456789
# Cron schedule for feed polling / classification / notification cycle
POLL_CRON_SCHEDULE=0 * * * *
# Minimum classifier score (0-1) required for a match to count as relevant, even if the model says "relevant: true"
MIN_RELEVANCE_SCORE=0.5
